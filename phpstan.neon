parametersSchema:
    anaProjectName: string()

parameters:
    level: 0
    anaProjectName: Sqler
    paths:
        - C:\vamp\apache\htdocs\Ocallit\Sqler/Src
    bootstrapFiles:
        - C:\vamp\apache\htdocs\Ocallit\Sqler\vendor\autoload.php

services:
    -
        class: App\PHPStan\ClassDefinitionCollector
        tags:
            - phpstan.collector
    -
        class: App\PHPStan\MethodDefinitionCollector
        tags:
            - phpstan.collector
    -
        class: App\PHPStan\MethodCallCollector
        tags:
            - phpstan.collector
    -
        class: App\PHPStan\ExportMetricsRule
        arguments:
            projectName: %anaProjectName%
        tags:
            - phpstan.rules.rule
