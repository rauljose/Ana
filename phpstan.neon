parameters:
    level: 0
    paths:
        - C:\vamp\apache\htdocs\Ocallit\Sqler/Src
    bootstrapFiles:
        - C:\vamp\apache\htdocs\Ocallit\Sqler\vendor\autoload.php

services:
    -
        class: App\PHPStan\ClassDefinitionCollector
        tags:
            - phpstan.collector
    -
        class: App\PHPStan\MethodDefinitionCollector
        tags:
            - phpstan.collector
    -
        class: App\PHPStan\MethodCallCollector
        tags:
            - phpstan.collector

rules:
    - App\PHPStan\ExportMetricsRule
