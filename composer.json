{
    "name": "ocallit/ana",
    "description": "An opinionated PHPStan plugin for PHP 8.4 that records classes, methods and calls to map call graphs and measure complexities.",
    "type": "phpstan-extension",
    "license": "MIT",
    "keywords": ["phpstan", "phpstan-extension", "static analysis", "call graph", "complexity", "metrics", "opinionated"],
    "homepage": "https://github.com/rauljose/Ana",
    "support": {
        "issues": "https://github.com/rauljose/Ana/issues",
        "source": "https://github.com/rauljose/Ana"
    },
    "require": {
        "php": ">=8.4",
        "nikic/php-parser": "^5.3",
        "ext-mysqli": "*",
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\PHPStan\\": "src/PHPStan/"
        }
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
