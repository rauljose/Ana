{
    "name": "ocallit/ana",
    "description": "A custom PHP 8.4 static analysis tool to map call graphs and measure complexities.",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "nikic/php-parser": "^5.3",
        "ext-mysqli": "*",
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\PHPStan\\": "src/PHPStan/"
        }
    },
    "config": {
        "sort-packages": true
    }
}