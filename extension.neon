parametersSchema:
    anaProjectName: string()

services:
    -
        class: App\PHPStan\ClassDefinitionCollector
        tags:
            - phpstan.collector
    -
        class: App\PHPStan\MethodDefinitionCollector
        tags:
            - phpstan.collector
    -
        class: App\PHPStan\MethodCallCollector
        tags:
            - phpstan.collector
    -
        class: App\PHPStan\ExportMetricsRule
        arguments:
            projectName: %anaProjectName%
        tags:
            - phpstan.rules.rule
